APP_ENV=testing
APP_DEBUG=true

# Clave de ejemplo, exclusiva del entorno de pruebas. No usar en ningun otro lado.
# Generar una propia con: php artisan key:generate --env=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

DB_CONNECTION=sqlite

# Los tests usan el driver `array`: no se envia ningun correo real, asi que no
# hacen falta credenciales. Si necesitas probar contra un buzon de captura,
# ponelas en un .env.testing.local que NO se versiona.
MAIL_MAILER=array
MAIL_FROM_ADDRESS="pruebas@ena.local"
MAIL_FROM_NAME="ENA Pruebas"
